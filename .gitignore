# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/Backup/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Aa]ssets/AssetStoreTools*

# Shared Unity baseline and assets organized by role
/Assets/*
!/Assets/Scripts/
!/Assets/Scripts.meta
!/Assets/Editor/
!/Assets/Editor.meta
!/Assets/Tests/
!/Assets/Tests.meta
!/Assets/Data/
!/Assets/Data.meta
!/Assets/Prefabs/
!/Assets/Prefabs.meta
!/Assets/Art/
!/Assets/Art.meta
!/Assets/Scenes/
!/Assets/Scenes.meta
!/Assets/Settings/
!/Assets/Settings.meta
!/Assets/Welcome/
!/Assets/Welcome.meta
!/Assets/Shaders/
!/Assets/Shaders.meta
/Assets/Shaders/*
!/Assets/Shaders/Desktop/
!/Assets/Shaders/Desktop.meta

# Preserve the existing shared window shader graph and its checked dependencies only.
!/Assets/Shader Graph/
!/Assets/Shader Graph.meta
/Assets/Shader Graph/*
!/Assets/Shader Graph/Transparent.shadergraph
!/Assets/Shader Graph/Transparent.shadergraph.meta
!/Assets/Shader Graph/TPMaterial.mat
!/Assets/Shader Graph/TPMaterial.mat.meta
!/Assets/Shader Graph/TPM.mat
!/Assets/Shader Graph/TPM.mat.meta

# Share the desktop feature in each role; keep unrelated local files excluded
/Assets/Scripts/*
!/Assets/Scripts/Desktop/
!/Assets/Scripts/Desktop.meta
/Assets/Editor/*
!/Assets/Editor/Desktop/
!/Assets/Editor/Desktop.meta
/Assets/Tests/*
!/Assets/Tests/Editor/
!/Assets/Tests/Editor.meta
/Assets/Tests/Editor/*
!/Assets/Tests/Editor/Desktop/
!/Assets/Tests/Editor/Desktop.meta
/Assets/Data/*
!/Assets/Data/Desktop/
!/Assets/Data/Desktop.meta
/Assets/Prefabs/*
!/Assets/Prefabs/Desktop/
!/Assets/Prefabs/Desktop.meta

# Share the desktop's source artwork; keep unrelated local artwork excluded
/Assets/Art/*
!/Assets/Art/Icon/
!/Assets/Art/Icon.meta
!/Assets/Art/Screen/
!/Assets/Art/Screen.meta
!/Assets/Art/Fonts/
!/Assets/Art/Fonts.meta

# Local prototype depends on scripts outside the shared baseline
/Assets/Scenes/DesktopPrototype.unity
/Assets/Scenes/DesktopPrototype.unity.meta

# Settings generated by local editor tooling
/ProjectSettings/Packages/com.unity.pipeline/
/ProjectSettings/SceneTemplateSettings.json

# IDE generated files
.vs/
.idea/
.vscode/
.gradle/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db
*.pdb
*.mdb
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and generated Unity data
sysinfo.txt
*.stacktrace
/[Aa]ssets/[Ss]treamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/AddressableAssetsData/*/*.json*
/[Aa]ssets/AddressableAssetsData/link.xml*

# Local credentials and environment settings
.env
.env.*
!.env.example
!.env.sample
*.keystore
*.jks
.aws/

# Local agent settings
.codex/
.agents/

# Local build / cache
.local/

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini
