# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Aa]ssets/AssetStoreTools*

# Shared Unity baseline and desktop implementation
/Assets/*
!/Assets/Desktop/
!/Assets/Desktop.meta
!/Assets/Art/
!/Assets/Art.meta
!/Assets/Scenes/
!/Assets/Scenes.meta
!/Assets/Settings/
!/Assets/Settings.meta
!/Assets/Welcome/
!/Assets/Welcome.meta

# Share the desktop's source artwork; keep unrelated local artwork excluded
/Assets/Art/*
!/Assets/Art/Icon/
!/Assets/Art/Icon.meta
!/Assets/Art/Screen/
!/Assets/Art/Screen.meta

# Local prototype depends on scripts outside the shared baseline
/Assets/Scenes/DesktopPrototype.unity
/Assets/Scenes/DesktopPrototype.unity.meta

# Settings generated by local editor tooling
/ProjectSettings/Packages/com.unity.pipeline/
/ProjectSettings/SceneTemplateSettings.json

# IDE generated files
.vs/
.idea/
.vscode/
.gradle/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db
*.pdb
*.mdb
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and generated Unity data
sysinfo.txt
*.stacktrace
/[Aa]ssets/[Ss]treamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/AddressableAssetsData/*/*.json*
/[Aa]ssets/AddressableAssetsData/link.xml*

# Local credentials and environment settings
.env
.env.*
!.env.example
!.env.sample
*.keystore
*.jks
.aws/

# Local agent settings
.codex/
.agents/

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini
