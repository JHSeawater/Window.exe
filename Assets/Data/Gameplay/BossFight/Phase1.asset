  - "[DELETE] C:\\Users\\Administrator\\Downloads\\ ....................................... DOWNLOADED CONTENT AND ORIGINAL SOURCE REFERENCES REMOVED"
  - "[DELETE] C:\\Users\\Administrator\\Desktop\\IMPORTANT_BACKUP\\ ........................ SECONDARY COPIES LOCATED AND DESTROYED"
